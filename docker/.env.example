# =============================================================================
# WFP Docker Compose 환경 변수
# 운영에서는 .env로 복사 후 모든 값을 강한 랜덤으로 교체.
# =============================================================================

# ---- 공통 ----
# 운영 도메인 — TLS(compose.prod.tls.yaml) 사용 시에만 필수.
# IP 기반 접속만 할 거면 두 값 모두 주석 처리하거나 비워도 됨.
# DOMAIN=wfp.example.com
# ACME_EMAIL=admin@example.com

# ---- DB 모드 전환 ----
# dev 기본: SQLite (값 미지정 시 sqlite:////data/wfp.db).
# PostgreSQL 사용 시 아래 줄 주석 해제:
# DATABASE_URL=postgresql://wfp:wfp-dev@postgres:5432/wfp

# ---- 슈퍼바이저 (관리자 계정) ----
# 서버 시작 시 해당 계정이 없으면 자동 생성, 있으면 ADMIN 권한 보장.
# 회원가입으로 가입한 사용자는 항상 USER 권한.
SUPERVISOR_ID=admin@example.com
SUPERVISOR_PASSWORD=replace-with-strong-password

# ---- JWT ----
# 미지정 시 NEXTAUTH_SECRET 사용. 운영은 별도 강한 키 권장.
JWT_SECRET=replace-with-openssl-rand-base64-32-bytes-or-longer

# ---- HuggingFace ----
# 비공개 모델 다운로드 시 필요
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxx

# ---- PostgreSQL ----
POSTGRES_PASSWORD=replace-with-strong-password

# ---- Redis ----
REDIS_PASSWORD=replace-with-strong-password

# ---- MinIO (S3 호환) ----
MINIO_ROOT_USER=wfp-minio
MINIO_ROOT_PASSWORD=replace-with-strong-password

# ---- NextAuth ----
# openssl rand -base64 32 로 생성
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
# IP 기반 접속 — 서버 IP 또는 http://localhost
# 도메인 + TLS 사용 시 — https://your-domain.com 으로 변경
NEXTAUTH_URL=http://localhost

# ---- WebSocket (잡 진행 스트림) ----
# 브라우저가 직접 worker `/ws/{job_id}` 에 연결. Next.js 는 WS proxy 안 함.
# 우선순위: NEXT_PUBLIC_WS_BASE > (페이지호스트 + NEXT_PUBLIC_WORKER_WS_PORT)
#
# Traefik(compose.prod) 운영 — /ws/* 가 worker:8000 으로 프록시되므로
# 도메인 또는 IP(포트 없음) 만 지정:
#   NEXT_PUBLIC_WS_BASE=ws://192.168.8.80
#   NEXT_PUBLIC_WS_BASE=wss://wfp.example.com   # TLS
#
# PM2 직접 운영 (Traefik 없이 :3000 = Next, :8000 = worker 별도 노출):
#   비워두고 NEXT_PUBLIC_WORKER_WS_PORT=8000 만 지정 → 페이지 호스트로 자동 추론.
#
# ⚠ NEXT_PUBLIC_* 은 빌드 타임 inline. 변경 시 frontend 재빌드 필수.
# NEXT_PUBLIC_WS_BASE=
# NEXT_PUBLIC_WORKER_WS_PORT=8000

# ---- 개발 편의 ----
# 개발 환경에서 인증 미들웨어 우회 (운영에서는 절대 true 금지)
NEXT_PUBLIC_AUTH_DISABLED=true

# ---- Gradio Playground (선택) ----
GRADIO_BASE_URL=http://localhost:7860

# ---- OAuth Providers (선택) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ---- Worker — HW 규칙 (선택) ----
# 기본: ops repo의 rules/hw_to_plan.yaml 자동 탐색 (sibling repo 또는 Docker mount)
# 커스텀 경로 사용 시:
# WFP_RULES_PATH=/path/to/custom/hw_to_plan.yaml

# ---- 빌드 컨텍스트 경로 ----
# 기본값: docker/ 기준 상대경로 ../../Finetuning-Pipeline-{worker,frontend}
# (서버: ops와 worker/frontend가 같은 부모 디렉토리의 형제 구조)
#
# Makefile은 자동으로 절대경로를 감지해 env로 주입함. 수동 실행 시에만 필요.
# macOS 워크스페이스처럼 위치가 다를 경우 아래 주석 해제 후 실제 경로로 수정.
# WFP_WORKER_DIR=/Users/wise/Developer/DA(Python,R,...)/Finetuning-Pipeline-worker
# WFP_FRONTEND_DIR=/Users/wise/Developer/Web(Node,Script)/Finetuning-Pipeline-frontend
